# =============================================================================
# DIBBS Bid Copilot - environment variables
# Copy to .env and adjust. Every variable is optional for demo mode:
# `docker compose up -d && make seed` works with this file unchanged.
# =============================================================================

# --- Core ---------------------------------------------------------------------
# SQLAlchemy URL. Postgres 16 in docker compose. SQLite (sqlite:///./data/app.db)
# is supported for local development and tests only.
DATABASE_URL=postgresql+psycopg://dibbs:dibbs@postgres:5432/dibbs
# Redis for RQ background jobs and rate limiting. Leave empty to run jobs inline.
REDIS_URL=redis://redis:6379/0
# Secret used to sign JWT access/refresh tokens. CHANGE IN PRODUCTION.
JWT_SECRET=change-me-in-production-please-use-64-random-chars
# Mark auth cookies `Secure`. Use true behind HTTPS. Browsers accept Secure
# cookies on http://localhost, but some test runners do not, so demo default is false.
COOKIE_SECURE=false
# Public origin of the frontend; CORS is restricted to it and emails link to it.
FRONTEND_ORIGIN=http://localhost:3000
# Demo mode: mock LLM, console email, mock voice, fixture connectors by default.
DEMO_MODE=true
# Log level for the backend (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO

# --- LLM (Anthropic) ------------------------------------------------------------
# Without a key (or with DEMO_MODE=true and LLM_PROVIDER unset) a deterministic mock is used.
ANTHROPIC_API_KEY=
# Model used for RFQ email drafting and quote extraction.
LLM_MODEL=claude-sonnet-5-5
# anthropic | mock. Empty = anthropic if ANTHROPIC_API_KEY is set, else mock.
LLM_PROVIDER=

# --- Email ----------------------------------------------------------------------
# console (default; stores messages in the DB) | resend
EMAIL_PROVIDER=console
RESEND_API_KEY=
# From address for outbound mail, e.g. "Quotes <quotes@yourdomain.com>"
EMAIL_FROM=DIBBS Bid Copilot <quotes@copilot.example.com>
# Domain for per-request reply-to addresses: quotes+<token>@<domain>
EMAIL_REPLY_DOMAIN=copilot.example.com
# Shared secret for the inbound email webhook (HMAC-SHA256 of the raw body,
# hex, in the X-Inbound-Signature header).
INBOUND_EMAIL_SECRET=dev-inbound-secret

# --- External data --------------------------------------------------------------
# SAM.gov Entity Management API key (public tier is fine). Optional.
SAM_API_KEY=
# Apify token for the optional ApifyDibbsConnector fallback. Optional.
APIFY_TOKEN=
# Apify actor id for the DIBBS RFQ actor (used only with APIFY_TOKEN).
APIFY_DIBBS_ACTOR=
# Identifying User-Agent for all scrapers. Put a contact address in it.
SCRAPER_USER_AGENT=DIBBSBidCopilot/0.1 (+mailto:ops@copilot.example.com)
# fixture (default, offline) | live | apify
CONNECTOR_MODE=fixture
# Where raw responses are cached (data/raw/<source>/<date>/)
RAW_CACHE_DIR=./data/raw

# --- Voice (optional, off by default) ---------------------------------------------
VOICE_ENABLED=false
# mock (default) | twilio_elevenlabs
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# ElevenLabs phone number id (imported Twilio number) for outbound calls
ELEVENLABS_PHONE_NUMBER_ID=
# Secret for ElevenLabs post-call webhooks (HMAC)
ELEVENLABS_WEBHOOK_SECRET=
# Optional: OpenAI key, only for Whisper post-call transcription fallback
OPENAI_API_KEY=
# Public base URL of the backend for Twilio/ElevenLabs callbacks
PUBLIC_API_BASE_URL=http://localhost:8000

# --- ML -------------------------------------------------------------------------------
# Directory for model artifacts
MODEL_ARTIFACT_DIR=./ml/artifacts
